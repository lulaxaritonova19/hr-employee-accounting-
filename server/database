const { Pool } = require('pg')

const pool = new Pool({
	host: 'localhost',
	user: 'postgres',
	password: '0000',
	database: 'hr_database',
	port: 5432,
})

pool.connect((err, client, release) => {
	if (err) {
		console.error('❌ Ошибка подключения:', err.stack)
		return
	}
	console.log('✅ Подключено к PostgreSQL')
	release()
})

module.exports = pool
